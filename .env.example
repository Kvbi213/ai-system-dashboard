# =============================================================================
# OMNIDASH REBORN (v4.0.0) — WZORZEC ZMIENNYCH ŚRODOWISKOWYCH (.env.example)
# =============================================================================

# Środowisko uruchomieniowe
NODE_ENV=development
PORT=5000
WEB_PORT=3000

# Bezpieczeństwo i Whitelist domen CORS (Rozdzielone przecinkami, bez wieloznacznika '*')
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000
OPERATOR_EMAIL=marektowarek21372137@gmail.com
SYSTEM_PIN=

# Baza Danych PostgreSQL (Drizzle ORM)
DATABASE_URL=postgresql://omnidash:omnidash_secret_pass@localhost:5432/omnidash_db
DB_USER=omnidash
DB_PASSWORD=omnidash_secret_pass
DB_NAME=omnidash_db

# Szyna Redis (Pub/Sub & Rate Limiter)
REDIS_URL=redis://:redis_secret_pass@localhost:6379
REDIS_PASSWORD=redis_secret_pass

# Klucze API Modeli AI (Tylko po stronie serwera)
GROQ_API_KEY=
BRAVE_SEARCH_API_KEY=

# Komunikacja Mobilna Pushbullet
PUSHBULLET_API_KEY=

# Mail Triage (IMAP SSL/TLS) & Push Notification Sentinel
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
TRIAGE_INTERVAL_MINUTES=15

# Synteza i Rozpoznawanie Mowy
FISH_AUDIO_API_KEY=
ELEVENLABS_API_KEY=

# Poświadczenia Librus Synergia (Szyfrowane w magazynie serwera)
LIBRUS_LOGIN=
LIBRUS_PASSWORD=

# Integracja z Google Cloud Platform & Firebase
FIREBASE_PROJECT_ID=omnidash-509607
GOOGLE_CLIENT_ID=
