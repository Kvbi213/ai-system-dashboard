PORT=5000
NODE_ENV=development
GROQ_API_KEY=your_groq_api_key
WEATHER_LAT=52.2297
WEATHER_LON=21.0122
BRAVE_SEARCH_API_KEY=your_brave_search_api_key
VITE_BRAVE_SEARCH_API_KEY=your_brave_search_api_key
PUSHBULLET_API_KEY=your_pushbullet_api_key
DASHBOARD_PIN=1234
SESSION_SECRET=your_session_secret_key

# Firebase Cloud Configuration (opcjonalne - wymagane tylko w trybie synchronizacji chmurowej)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_OWNER_EMAIL=your_email@domain.com
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# Google Cloud Console & Pub/Sub Budget Guard
GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_PROJECT_ID=your-gcp-project-id
GCP_BUDGET_LIMIT=1.0
VITE_GCP_BUDGET_LIMIT=1.0
GCP_PUBSUB_TOPIC=budget-auto-stop
VITE_GCP_PUBSUB_TOPIC=budget-auto-stop
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_TTS_API_KEY=your_google_tts_api_key
VITE_GOOGLE_TTS_API_KEY=your_google_tts_api_key

# ElevenLabs Studio AI Voice API
ELEVENLABS_API_KEY=your_elevenlabs_api_key
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Pushbullet Direct Client API
VITE_PUSHBULLET_API_KEY=your_pushbullet_api_key
LIBRUS_LOGIN=your_librus_login
LIBRUS_PASSWORD=your_librus_password

