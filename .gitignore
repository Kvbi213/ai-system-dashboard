# Node dependencies
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build artifacts
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment variables & secrets (Zero-Client Exposure)
.env
.env.local
.env.*.local
*.pem
*.key
firebase-service-account.json

# Database & local data
*.sqlite
*.sqlite-wal
*.sqlite-shm
data/storage/
apps/api/data/

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Testing & logs
coverage/
playwright-report/
test-results/
*.log
.superpowers/

# Temporary files
tmp/
scratch/
graphify-out/cache/

# Documentation filter (Only track canonical docs: README, TODO, HISTORY, ARCHITECTURE, and /docs/versions)
docs/*
!docs/versions/
!docs/versions/*.md
!docs/deploy/
!docs/deploy/*.md
!docs/errors/
!docs/errors/*.md
*.draft.md
*.spec.md
