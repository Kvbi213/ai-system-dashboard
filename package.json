{
  "name": "omnidash-monorepo",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "build": "pnpm --filter @omnidash/* run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @omnidash/* run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
