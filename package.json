{
  "name": "omnidash",
  "private": true,
  "version": "2.13.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "node --watch --watch-path=./modules --watch-path=./core.server.js core.server.js",
    "start": "concurrently \"npm run dev:server\" \"wait-on http-get://127.0.0.1:5000/api/system/keys-status && npm run dev:client\"",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "groq-sdk": "^0.3.3",
    "i18next": "^26.3.6",
    "lucide-react": "^0.394.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "remark-gfm": "^4.0.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "eslint": "^8.57.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.10"
  }
