{
    admin off
    auto_https off
}

:80 {
    root * /usr/share/caddy
    file_server
    encode zstd gzip

    # Blokada robotów, crawlerów i wyszukiwarek (Pełna Prywatność)
    handle /robots.txt {
        header Content-Type "text/plain"
        respond `User-agent: *
Disallow: /
` 200
    }

    # Prosty endpoint healthcheck dla Dockera i monitoringu
    handle /healthz {
        respond "OK" 200
    }

    # Rygorystyczne nagłówki bezpieczeństwa i anty-indeksowania
    header {
        # Całkowity zakaz indeksowania i archiwizowania przez wyszukiwarki i boty AI
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, notranslate, noimageindex"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Proxy zapytań API do kontenera omnidash-api
    handle /api/* {
        reverse_proxy omnidash-api:5000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Długoterminowy cache nagłówków dla zasobów statycznych
    @static path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.woff2 *.woff *.eot *.ttf *.svg
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Obsługa routingu SPA React — zapobieganie błędom 404
    handle {
        try_files {path} /index.html
    }
}
