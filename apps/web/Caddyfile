{
    admin off
    auto_https off
}

:80 {
    root * /usr/share/caddy
    file_server
    encode zstd gzip

    # Prosty endpoint healthcheck dla Dockera i monitoringu
    handle /healthz {
        respond "OK" 200
    }

    # Bezpieczne nagłówki
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Proxy zapytań API do kontenera omnidash-api
    handle /api/* {
        reverse_proxy omnidash-api:5000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Długoterminowy cache nagłówków dla zasobów statycznych
    @static path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.woff2 *.woff *.eot *.ttf *.svg
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Obsługa routingu SPA React — zapobieganie błędom 404
    handle {
        try_files {path} /index.html
    }
}
