{
  "name": "ai-system-dashboard",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/entities/(.*)", "destination": "/api/entities?path=$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/agent",
      "schedule": "* * * * *"
    }
  ]
}
