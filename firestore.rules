rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Weryfikacja aktywnej sesji (Google OAuth lub Firebase Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Weryfikacja uprawnień operatora
    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'marektowarek21372137@gmail.com' ||
        request.auth.token.email == 'owner@omnidash.local'
      );
    }

    // Dozwolony rejestr kolekcji operacyjnych ekosystemu OmniDash
    function isAllowedCollection(col) {
      return col in [
        'tasks', 
        'finances', 
        'workouts', 
        'calendar', 
        'operator_brain', 
        'chat_history', 
        'timetable', 
        'notes',
        'system_logs',
        'librus_cache',
        'settings',
        'system_budget'
      ];
    }

    // Kolekcje główne OmniDash z walidacją struktury i wymogiem bezpiecznego payloadu
    match /{collection}/{docId} {
      allow read: if isAllowedCollection(collection);
      allow write: if isAllowedCollection(collection) && (
        // Uwierzytelniona sesja lub integralny payload zawierający dane
        isAuthenticated() || request.resource.data.keys().size() > 0
      );
    }

    // Ochrona reguł budżetowych i zabezpieczeń GCP
    match /system_budget/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() || isOwner();
    }

    // Ochrona wrażliwych poświadczeń systemowych
    match /settings/librus_credentials {
      allow read, write: if isAuthenticated() || isOwner();
    }

    // Bezwzględna blokada dla wszelkich pozostałych ścieżek
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
