rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Weryfikacja aktywnej sesji uwierzytelnionej (Google OAuth lub Firebase Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Weryfikacja uprawnień właściciela systemu
    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'marektowarek21372137@gmail.com' ||
        request.auth.token.email == 'owner@omnidash.local'
      );
    }

    // Dozwolony rejestr kolekcji operacyjnych ekosystemu OmniDash
    function isAllowedCollection(col) {
      return col in [
        'tasks', 
        'finances', 
        'workouts', 
        'calendar', 
        'operator_brain', 
        'chat_history', 
        'timetable', 
        'notes',
        'system_logs',
        'librus_cache',
        'settings',
        'system_budget'
      ];
    }

    // Kolekcje główne: bezwzględny wymóg uwierzytelnienia sesji (Zero-Trust)
    match /{collection}/{docId} {
      allow read, write: if isAllowedCollection(collection) && isAuthenticated();
    }

    // Ochrona reguł budżetowych i zabezpieczeń GCP (wymóg uwierzytelnienia)
    match /system_budget/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // Ochrona wrażliwych poświadczeń systemowych
    match /settings/librus_credentials {
      allow read, write: if isOwner();
    }

    // Bezwzględna blokada dla wszelkich pozostałych ścieżek
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
